export global AppState {
    in-out property <int> touch-count: 0;
    in-out property <int> fps: 0;
    in-out property <string> status-text: "就绪";
    in-out property <string> clock-text: "--:--:--";
    in-out property <string> date-text: "--日";
    in-out property <string> seconds-text: "--";
    in-out property <int> seconds-value: -1;
    in-out property <string> weekday-text: "(--)";
    in-out property <int> utc-offset-hours: 8;
    in-out property <bool> menu-open: false;
    in-out property <int> menu-view: 0;
    in-out property <int> wifi-scan-state: 0;
    in-out property <string> wifi-scan-status: "点击扫描附近网络";
    in-out property <bool> wifi-ap-enabled: false;
    in-out property <string> wifi-ap-status: "已关闭";
    in-out property <bool> wifi-station-enabled: true;
    in-out property <string> wifi-connection-status: "未连接";
    in-out property <string> wifi-connection-ssid: "无目标网络";
    in-out property <int> wifi-network-count: 0;
    in-out property <[string]> wifi-networks: [];
    in-out property <[string]> wifi-network-details: [];
    in-out property <string> wifi-selected-ssid: "";
    in-out property <string> wifi-password: "";
    in-out property <bool> wifi-shift: false;
    in-out property <bool> wifi-symbols: false;
    in-out property <int> ble-scan-state: 0;
    in-out property <bool> ble-enabled: false;
    in-out property <string> ble-scan-status: "点击扫描附近设备";
    in-out property <int> ble-device-count: 0;
    in-out property <[string]> ble-devices: [];
    in-out property <[string]> ble-device-details: [];
    in-out property <int> ble-selected-index: -1;
    in-out property <string> ble-selected-name: "";
    in-out property <string> ble-code: "";
    in-out property <string> ble-pair-status: "请输入 6 位配对码";
    in-out property <string> ble-display-code: "";
    in-out property <int> ble-pair-state: 0;

    callback wifi-scan-requested();
    callback wifi-ap-toggle-requested(bool);
    callback wifi-station-toggle-requested(bool);
    callback wifi-disconnect-requested();
    callback wifi-key-pressed(string);
    callback wifi-password-submit();
    callback ble-scan-requested();
    callback ble-toggle-requested(bool);
    callback ble-key-pressed(string);
    callback ble-pair-submit();
    callback ble-pair-confirmed();
    callback clear-requested();
    callback utc-offset-adjust-requested(int);
    callback utc-offset-reset-requested();
}

export component StateRoot inherits Rectangle {
    width: 356px;
    height: 356px;
    background: transparent;

    in-out property <int> touch-count <=> AppState.touch-count;
    in-out property <int> fps <=> AppState.fps;
    in-out property <string> status-text <=> AppState.status-text;
    in-out property <string> clock-text <=> AppState.clock-text;
    in-out property <string> date-text <=> AppState.date-text;
    in-out property <string> seconds-text <=> AppState.seconds-text;
    in-out property <int> seconds-value <=> AppState.seconds-value;
    in-out property <string> weekday-text <=> AppState.weekday-text;
    in-out property <int> utc-offset-hours <=> AppState.utc-offset-hours;
    in-out property <bool> menu-open <=> AppState.menu-open;
    in-out property <int> menu-view <=> AppState.menu-view;
    in-out property <int> wifi-scan-state <=> AppState.wifi-scan-state;
    in-out property <string> wifi-scan-status <=> AppState.wifi-scan-status;
    in-out property <bool> wifi-ap-enabled <=> AppState.wifi-ap-enabled;
    in-out property <string> wifi-ap-status <=> AppState.wifi-ap-status;
    in-out property <bool> wifi-station-enabled <=> AppState.wifi-station-enabled;
    in-out property <string> wifi-connection-status <=> AppState.wifi-connection-status;
    in-out property <string> wifi-connection-ssid <=> AppState.wifi-connection-ssid;
    in-out property <int> wifi-network-count <=> AppState.wifi-network-count;
    in-out property <[string]> wifi-networks <=> AppState.wifi-networks;
    in-out property <[string]> wifi-network-details <=> AppState.wifi-network-details;
    in-out property <string> wifi-selected-ssid <=> AppState.wifi-selected-ssid;
    in-out property <string> wifi-password <=> AppState.wifi-password;
    in-out property <bool> wifi-shift <=> AppState.wifi-shift;
    in-out property <bool> wifi-symbols <=> AppState.wifi-symbols;
    in-out property <int> ble-scan-state <=> AppState.ble-scan-state;
    in-out property <bool> ble-enabled <=> AppState.ble-enabled;
    in-out property <string> ble-scan-status <=> AppState.ble-scan-status;
    in-out property <int> ble-device-count <=> AppState.ble-device-count;
    in-out property <[string]> ble-devices <=> AppState.ble-devices;
    in-out property <[string]> ble-device-details <=> AppState.ble-device-details;
    in-out property <int> ble-selected-index <=> AppState.ble-selected-index;
    in-out property <string> ble-selected-name <=> AppState.ble-selected-name;
    in-out property <string> ble-code <=> AppState.ble-code;
    in-out property <string> ble-pair-status <=> AppState.ble-pair-status;
    in-out property <string> ble-display-code <=> AppState.ble-display-code;
    in-out property <int> ble-pair-state <=> AppState.ble-pair-state;


}

export component PageFrame inherits StateRoot {
    background: #f4f7fb;
    border-radius: 178px;
    border-width: 3px;
    border-color: #25415f;
    clip: true;
}
