import "./fonts/NotoSansSC-UI.ttf";

component MenuItem inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    callback activated();

    width: 276px;
    height: 34px;
    background: #ffffff;
    border-radius: 14px;
    border-width: 1px;
    border-color: #d8e1eb;

    TouchArea {
        clicked => {
            root.activated();
        }
    }

    Text {
        x: 16px;
        y: 4px;
        width: parent.width - 32px;
        text: root.label;
        color: #14253a;
        font-size: 12px;
        font-weight: 600;
    }

    Text {
        x: 16px;
        y: 20px;
        width: parent.width - 32px;
        text: root.detail;
        color: #71839a;
        font-size: 8px;
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    callback activated();

    width: 136px;
    height: 38px;
    background: #25415f;
    border-radius: 19px;

    TouchArea {
        clicked => {
            root.activated();
        }
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    width: 360px;
    height: 360px;
    background: #05070b;
    default-font-family: "Noto Sans SC";

    in-out property <int> touch-count: 0;
    in-out property <int> fps: 0;
    in-out property <string> status-text: "就绪";
    in-out property <string> clock-text: "--:--:--";
    in-out property <string> date-text: "RTC 未设置";
    in-out property <bool> menu-open: false;
    in-out property <int> menu-view: 0;
    callback clear-requested();

    Rectangle {
        x: 2px;
        y: 2px;
        width: 356px;
        height: 356px;
        background: root.menu-open ? #f4f7fb : #0d1a2d;
        border-radius: 178px;
        border-width: 3px;
        border-color: root.menu-open ? #25415f : #40688d;
        clip: true;

        if root.menu-open == false: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            Text {
                x: 0px;
                y: 38px;
                width: parent.width;
                text: "ESP32-S3";
                color: #8ea6bf;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                x: 0px;
                y: 76px;
                width: parent.width;
                text: root.clock-text;
                color: #ffffff;
                font-size: 50px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                x: 0px;
                y: 145px;
                width: parent.width;
                text: root.date-text;
                color: #b9cadb;
                font-size: 15px;
                horizontal-alignment: center;
            }

            Rectangle {
                x: 78px;
                y: 194px;
                width: 204px;
                height: 1px;
                background: #40688d;
            }

            Text {
                x: 0px;
                y: 218px;
                width: parent.width;
                text: "向右滑动";
                color: #ffffff;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
            }

            Text {
                x: 0px;
                y: 244px;
                width: parent.width;
                text: "打开功能菜单";
                color: #8ea6bf;
                font-size: 12px;
                horizontal-alignment: center;
            }

            Text {
                x: 0px;
                y: 286px;
                width: parent.width;
                text: "ST77916  /  CST816S  /  PCF85063";
                color: #55748f;
                font-size: 9px;
                horizontal-alignment: center;
            }
        }

        if root.menu-open: Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;

            if root.menu-view == 0: Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0px;
                    y: 28px;
                    width: parent.width;
                    text: "功能菜单";
                    color: #25415f;
                    font-size: 24px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    x: 0px;
                    y: 59px;
                    width: parent.width;
                    text: "选择功能";
                    color: #71839a;
                    font-size: 12px;
                    horizontal-alignment: center;
                }

                MenuItem {
                    x: 42px;
                    y: 72px;
                    label: "触摸计数";
                    detail: "点击卡片累计触摸次数";
                    activated => {
                        root.menu-view = 1;
                    }
                }

                MenuItem {
                    x: 42px;
                    y: 110px;
                    label: "动态演示";
                    detail: "运行 animation-tick 轨道动画";
                    activated => {
                        root.menu-view = 2;
                    }
                }

                MenuItem {
                    x: 42px;
                    y: 148px;
                    label: "性能监视";
                    detail: "查看实时渲染 FPS";
                    activated => {
                        root.menu-view = 3;
                    }
                }

                MenuItem {
                    x: 42px;
                    y: 186px;
                    label: "清零计数";
                    detail: "重置触摸计数";
                    activated => {
                        root.clear-requested();
                    }
                }

                MenuItem {
                    x: 42px;
                    y: 224px;
                    label: "WiFi 配置";
                    detail: "连接配置网络并打开网页";
                    activated => {
                        root.menu-view = 4;
                    }
                }

                MenuItem {
                    x: 42px;
                    y: 262px;
                    label: "蓝牙配置";
                    detail: "设置广播名称和开关";
                    activated => {
                        root.menu-view = 5;
                    }
                }
                Text {
                    x: 0px;
                    y: 310px;
                    width: parent.width;
                    text: "向左滑动返回主页";
                    color: #71839a;
                    font-size: 10px;
                    horizontal-alignment: center;
                }
            }

            if root.menu-view == 1: Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0px;
                    y: 30px;
                    width: parent.width;
                    text: "触摸计数";
                    color: #25415f;
                    font-size: 21px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Rectangle {
                    x: 40px;
                    y: 96px;
                    width: 276px;
                    height: 118px;
                    background: #ffffff;
                    border-radius: 22px;
                    border-width: 1px;
                    border-color: #d8e1eb;

                    TouchArea {
                        clicked => {
                            root.touch-count += 1;
                            root.status-text = "已收到触摸";
                        }
                    }

                    Text {
                        y: 18px;
                        width: parent.width;
                        text: "触摸次数";
                        color: #71839a;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }

                    Text {
                        y: 40px;
                        width: parent.width;
                        text: root.touch-count;
                        color: #14253a;
                        font-size: 40px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    Text {
                        y: 90px;
                        width: parent.width;
                        text: root.status-text;
                        color: #4d7c9f;
                        font-size: 10px;
                        horizontal-alignment: center;
                    }
                }

                NavButton {
                    x: 112px;
                    y: 270px;
                    label: "返回功能菜单";
                    activated => {
                        root.menu-view = 0;
                    }
                }
            }

            if root.menu-view == 2: Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0px;
                    y: 30px;
                    width: parent.width;
                    text: "动态演示";
                    color: #25415f;
                    font-size: 21px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                stage := Rectangle {
                    x: 30px;
                    y: 96px;
                    width: 296px;
                    height: 126px;
                    background: #ffffff;
                    border-radius: 24px;
                    border-width: 1px;
                    border-color: #d8e1eb;
                    private property <angle> orbit-angle: (360deg * animation-tick() / 1600ms).mod(360deg);

                    Rectangle {
                        x: 60px;
                        y: 18px;
                        width: 176px;
                        height: 88px;
                        border-radius: 44px;
                        border-width: 2px;
                        border-color: #d8e7f1;
                        background: transparent;
                    }

                    Rectangle {
                        x: 128px + 78px * sin(stage.orbit-angle);
                        y: 50px + 30px * sin(stage.orbit-angle + 90deg);
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: #e76f51;
                    }

                    Rectangle {
                        x: 52px + 180px * (stage.orbit-angle / 360deg);
                        y: 112px;
                        width: 8px;
                        height: 4px;
                        border-radius: 2px;
                        background: #4d7c9f;
                    }

                    Text {
                        x: 0px;
                        y: 108px;
                        width: parent.width;
                        text: "运行中";
                        color: #4d7c9f;
                        font-size: 10px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                }

                Text {
                    x: 0px;
                    y: 236px;
                    width: parent.width;
                    text: "animation-tick() 驱动轨道";
                    color: #25415f;
                    font-size: 11px;
                    horizontal-alignment: center;
                }

                NavButton {
                    x: 112px;
                    y: 270px;
                    label: "返回功能菜单";
                    activated => {
                        root.menu-view = 0;
                    }
                }
            }

            if root.menu-view == 3: Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0px;
                    y: 30px;
                    width: parent.width;
                    text: "性能监视";
                    color: #25415f;
                    font-size: 21px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                meter := Rectangle {
                    x: 40px;
                    y: 96px;
                    width: 276px;
                    height: 126px;
                    background: #ffffff;
                    border-radius: 24px;
                    border-width: 1px;
                    border-color: #d8e1eb;
                    private property <float> pulse: abs(sin(360deg * animation-tick() / 1000ms));

                    Rectangle {
                        x: 118px - 12px * meter.pulse;
                        y: 14px - 12px * meter.pulse;
                        width: 40px + 24px * meter.pulse;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: #e76f51;
                    }

                    Text {
                        y: 48px;
                        width: parent.width;
                        text: root.fps;
                        color: #14253a;
                        font-size: 40px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }

                    Text {
                        y: 98px;
                        width: parent.width;
                        text: "渲染 FPS";
                        color: #71839a;
                        font-size: 10px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                }

                NavButton {
                    x: 112px;
                    y: 270px;
                    label: "返回功能菜单";
                    activated => {
                        root.menu-view = 0;
                    }
                }
            }
            if root.menu-view == 4: Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0px;
                    y: 30px;
                    width: parent.width;
                    text: "WiFi 配置";
                    color: #25415f;
                    font-size: 21px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Rectangle {
                    x: 30px;
                    y: 82px;
                    width: 296px;
                    height: 154px;
                    background: #ffffff;
                    border-radius: 22px;
                    border-width: 1px;
                    border-color: #d8e1eb;

                    Text {
                        x: 18px;
                        y: 16px;
                        width: parent.width - 36px;
                        text: "连接：ESP32-S3-配置";
                        color: #14253a;
                        font-size: 12px;
                    }

                    Text {
                        x: 18px;
                        y: 46px;
                        width: parent.width - 36px;
                        text: "密码：esp32s3-config";
                        color: #14253a;
                        font-size: 12px;
                    }

                    Text {
                        x: 18px;
                        y: 76px;
                        width: parent.width - 36px;
                        text: "网页：http://192.168.4.1/";
                        color: #25415f;
                        font-size: 11px;
                    }

                    Text {
                        x: 18px;
                        y: 108px;
                        width: parent.width - 36px;
                        text: "提交目标 WiFi 后设备会尝试连接";
                        color: #71839a;
                        font-size: 10px;
                    }

                    Text {
                        x: 18px;
                        y: 128px;
                        width: parent.width - 36px;
                        text: "配置保存在运行内存中";
                        color: #71839a;
                        font-size: 10px;
                    }
                }

                NavButton {
                    x: 112px;
                    y: 270px;
                    label: "返回功能菜单";
                    activated => {
                        root.menu-view = 0;
                    }
                }
            }

            if root.menu-view == 5: Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0px;
                    y: 30px;
                    width: parent.width;
                    text: "蓝牙配置";
                    color: #25415f;
                    font-size: 21px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Rectangle {
                    x: 30px;
                    y: 82px;
                    width: 296px;
                    height: 154px;
                    background: #ffffff;
                    border-radius: 22px;
                    border-width: 1px;
                    border-color: #d8e1eb;

                    Text {
                        x: 18px;
                        y: 18px;
                        width: parent.width - 36px;
                        text: "请在配置网页中设置蓝牙名称";
                        color: #14253a;
                        font-size: 12px;
                    }

                    Text {
                        x: 18px;
                        y: 52px;
                        width: parent.width - 36px;
                        text: "网页地址：192.168.4.1";
                        color: #25415f;
                        font-size: 11px;
                    }

                    Text {
                        x: 18px;
                        y: 84px;
                        width: parent.width - 36px;
                        text: "蓝牙广播名称下一次广播生效";
                        color: #71839a;
                        font-size: 10px;
                    }

                    Text {
                        x: 18px;
                        y: 112px;
                        width: parent.width - 36px;
                        text: "可在网页中关闭蓝牙广播";
                        color: #71839a;
                        font-size: 10px;
                    }
                }

                NavButton {
                    x: 112px;
                    y: 270px;
                    label: "返回功能菜单";
                    activated => {
                        root.menu-view = 0;
                    }
                }
            }
        }
    }
}
