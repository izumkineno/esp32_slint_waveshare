import { AppState, PageFrame } from "../state.slint";

export { AppState }
export component HomePage inherits PageFrame {
    background: #0d1a2d;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;

        Text {
            x: 0px;
            y: 82px;
            width: parent.width;
            text: root.date-text;
            color: #a9bacb;
            font-size: 16px;
            horizontal-alignment: center;
        }

        Text {
            x: 0px;
            y: 116px;
            width: parent.width;
            text: root.clock-text;
            color: #ffffff;
            font-size: 58px;
            font-weight: 600;
            horizontal-alignment: center;
        }
            TouchArea {
                width: parent.width;
                height: parent.height;
                property <length> gesture-start-x;
                property <length> gesture-start-y;

                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        self.gesture-start-x = self.mouse-x;
                        self.gesture-start-y = self.mouse-y;
                    } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                        if (self.mouse-x - self.gesture-start-x >= 60px
                                && abs(self.mouse-y - self.gesture-start-y) <= 100px) {
                            root.menu-view = 0;
                            root.menu-open = true;
                        }
                    }
                }
            }
        }
}
