import { AppState, PageFrame } from "../state.slint";
import { KeyButton, NavButton } from "../components/controls.slint";
export { AppState }

export component WifiPasswordPage inherits PageFrame {
    // Page body is inserted below.
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;

                Text {
                    x: 0px;
                    y: 18px;
                    width: parent.width;
                    text: "输入 WiFi 密码";
                    color: #25415f;
                    font-size: 20px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }

                Text {
                    x: 20px;
                    y: 43px;
                    width: parent.width - 40px;
                    text: root.wifi-selected-ssid;
                    color: #71839a;
                    font-size: 11px;
                    horizontal-alignment: center;
                }

                Text {
                    x: 50px;
                    y: 66px;
                    width: 253px;
                    height: 30px;
                    overflow: TextOverflow.clip;
                    text: root.wifi-password;
                    color: #14253a;
                    font-size: 13px;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }

                Text {
                    x: 0px;
                    y: 99px;
                    width: parent.width;
                    text: "上下滑动查看更多按键";
                    color: #71839a;
                    font-size: 9px;
                    horizontal-alignment: center;
                }

                Flickable {
                    x: 8px;
                    y: 111px;
                    width: 344px;
                    height: 149px;
                    viewport-width: 344px;
                    viewport-height: 352px;

                    if root.wifi-symbols == false: Rectangle {
                        width: 344px;
                        height: 352px;
                        background: transparent;

                        KeyButton { x: 8px; y: 0px; value: "q"; pressed => AppState.wifi-key-pressed("q"); }
                        KeyButton { x: 76px; y: 0px; value: "w"; pressed => AppState.wifi-key-pressed("w"); }
                        KeyButton { x: 144px; y: 0px; value: "e"; pressed => AppState.wifi-key-pressed("e"); }
                        KeyButton { x: 212px; y: 0px; value: "r"; pressed => AppState.wifi-key-pressed("r"); }
                        KeyButton { x: 280px; y: 0px; value: "t"; pressed => AppState.wifi-key-pressed("t"); }

                        KeyButton { x: 8px; y: 44px; value: "y"; pressed => AppState.wifi-key-pressed("y"); }
                        KeyButton { x: 76px; y: 44px; value: "u"; pressed => AppState.wifi-key-pressed("u"); }
                        KeyButton { x: 144px; y: 44px; value: "i"; pressed => AppState.wifi-key-pressed("i"); }
                        KeyButton { x: 212px; y: 44px; value: "o"; pressed => AppState.wifi-key-pressed("o"); }
                        KeyButton { x: 280px; y: 44px; value: "p"; pressed => AppState.wifi-key-pressed("p"); }

                        KeyButton { x: 8px; y: 88px; value: "a"; pressed => AppState.wifi-key-pressed("a"); }
                        KeyButton { x: 76px; y: 88px; value: "s"; pressed => AppState.wifi-key-pressed("s"); }
                        KeyButton { x: 144px; y: 88px; value: "d"; pressed => AppState.wifi-key-pressed("d"); }
                        KeyButton { x: 212px; y: 88px; value: "f"; pressed => AppState.wifi-key-pressed("f"); }
                        KeyButton { x: 280px; y: 88px; value: "g"; pressed => AppState.wifi-key-pressed("g"); }

                        KeyButton { x: 8px; y: 132px; value: "h"; pressed => AppState.wifi-key-pressed("h"); }
                        KeyButton { x: 76px; y: 132px; value: "j"; pressed => AppState.wifi-key-pressed("j"); }
                        KeyButton { x: 144px; y: 132px; value: "k"; pressed => AppState.wifi-key-pressed("k"); }
                        KeyButton { x: 212px; y: 132px; value: "l"; pressed => AppState.wifi-key-pressed("l"); }
                        KeyButton { x: 280px; y: 132px; value: "z"; pressed => AppState.wifi-key-pressed("z"); }

                        KeyButton { x: 8px; y: 176px; value: "x"; pressed => AppState.wifi-key-pressed("x"); }
                        KeyButton { x: 76px; y: 176px; value: "c"; pressed => AppState.wifi-key-pressed("c"); }
                        KeyButton { x: 144px; y: 176px; value: "v"; pressed => AppState.wifi-key-pressed("v"); }
                        KeyButton { x: 212px; y: 176px; value: "b"; pressed => AppState.wifi-key-pressed("b"); }
                        KeyButton { x: 280px; y: 176px; value: "n"; pressed => AppState.wifi-key-pressed("n"); }

                        KeyButton { x: 8px; y: 220px; value: "m"; pressed => AppState.wifi-key-pressed("m"); }
                        KeyButton { x: 76px; y: 220px; value: "1"; pressed => AppState.wifi-key-pressed("1"); }
                        KeyButton { x: 144px; y: 220px; value: "2"; pressed => AppState.wifi-key-pressed("2"); }
                        KeyButton { x: 212px; y: 220px; value: "3"; pressed => AppState.wifi-key-pressed("3"); }
                        KeyButton { x: 280px; y: 220px; value: "4"; pressed => AppState.wifi-key-pressed("4"); }

                        KeyButton { x: 8px; y: 264px; value: "5"; pressed => AppState.wifi-key-pressed("5"); }
                        KeyButton { x: 76px; y: 264px; value: "6"; pressed => AppState.wifi-key-pressed("6"); }
                        KeyButton { x: 144px; y: 264px; value: "7"; pressed => AppState.wifi-key-pressed("7"); }
                        KeyButton { x: 212px; y: 264px; value: "8"; pressed => AppState.wifi-key-pressed("8"); }
                        KeyButton { x: 280px; y: 264px; value: "9"; pressed => AppState.wifi-key-pressed("9"); }

                        KeyButton { x: 8px; y: 308px; value: "0"; pressed => AppState.wifi-key-pressed("0"); }
                        KeyButton { x: 76px; y: 308px; value: "SHIFT"; pressed => AppState.wifi-key-pressed("SHIFT"); }
                        KeyButton { x: 144px; y: 308px; value: "SYM"; pressed => AppState.wifi-key-pressed("SYM"); }
                        KeyButton { x: 212px; y: 308px; value: "SPACE"; pressed => AppState.wifi-key-pressed("SPACE"); }
                        KeyButton { x: 280px; y: 308px; value: "BACK"; pressed => AppState.wifi-key-pressed("BACK"); }
                    }

                    if root.wifi-symbols: Rectangle {
                        width: 344px;
                        height: 352px;
                        background: transparent;

                        KeyButton { x: 8px; y: 0px; value: "!"; pressed => AppState.wifi-key-pressed("!"); }
                        KeyButton { x: 76px; y: 0px; value: "@"; pressed => AppState.wifi-key-pressed("@"); }
                        KeyButton { x: 144px; y: 0px; value: "#"; pressed => AppState.wifi-key-pressed("#"); }
                        KeyButton { x: 212px; y: 0px; value: "$"; pressed => AppState.wifi-key-pressed("$"); }
                        KeyButton { x: 280px; y: 0px; value: "%"; pressed => AppState.wifi-key-pressed("%"); }

                        KeyButton { x: 8px; y: 44px; value: "^"; pressed => AppState.wifi-key-pressed("^"); }
                        KeyButton { x: 76px; y: 44px; value: "&"; pressed => AppState.wifi-key-pressed("&"); }
                        KeyButton { x: 144px; y: 44px; value: "*"; pressed => AppState.wifi-key-pressed("*"); }
                        KeyButton { x: 212px; y: 44px; value: "("; pressed => AppState.wifi-key-pressed("("); }
                        KeyButton { x: 280px; y: 44px; value: ")"; pressed => AppState.wifi-key-pressed(")"); }

                        KeyButton { x: 8px; y: 88px; value: "-"; pressed => AppState.wifi-key-pressed("-"); }
                        KeyButton { x: 76px; y: 88px; value: "_"; pressed => AppState.wifi-key-pressed("_"); }
                        KeyButton { x: 144px; y: 88px; value: "="; pressed => AppState.wifi-key-pressed("="); }
                        KeyButton { x: 212px; y: 88px; value: "+"; pressed => AppState.wifi-key-pressed("+"); }
                        KeyButton { x: 280px; y: 88px; value: "["; pressed => AppState.wifi-key-pressed("["); }

                        KeyButton { x: 8px; y: 132px; value: "]"; pressed => AppState.wifi-key-pressed("]"); }
                        KeyButton { x: 76px; y: 132px; value: "{"; pressed => AppState.wifi-key-pressed("{"); }
                        KeyButton { x: 144px; y: 132px; value: "}"; pressed => AppState.wifi-key-pressed("}"); }
                        KeyButton { x: 212px; y: 132px; value: "/"; pressed => AppState.wifi-key-pressed("/"); }
                        KeyButton { x: 280px; y: 132px; value: "?"; pressed => AppState.wifi-key-pressed("?"); }

                        KeyButton { x: 8px; y: 176px; value: ":"; pressed => AppState.wifi-key-pressed(":"); }
                        KeyButton { x: 76px; y: 176px; value: ";"; pressed => AppState.wifi-key-pressed(";"); }
                        KeyButton { x: 144px; y: 176px; value: "."; pressed => AppState.wifi-key-pressed("."); }
                        KeyButton { x: 212px; y: 176px; value: ","; pressed => AppState.wifi-key-pressed(","); }
                        KeyButton { x: 280px; y: 176px; value: "<"; pressed => AppState.wifi-key-pressed("<"); }

                        KeyButton { x: 8px; y: 220px; value: ">"; pressed => AppState.wifi-key-pressed(">"); }
                        KeyButton { x: 76px; y: 220px; value: "1"; pressed => AppState.wifi-key-pressed("1"); }
                        KeyButton { x: 144px; y: 220px; value: "2"; pressed => AppState.wifi-key-pressed("2"); }
                        KeyButton { x: 212px; y: 220px; value: "3"; pressed => AppState.wifi-key-pressed("3"); }
                        KeyButton { x: 280px; y: 220px; value: "4"; pressed => AppState.wifi-key-pressed("4"); }

                        KeyButton { x: 8px; y: 264px; value: "5"; pressed => AppState.wifi-key-pressed("5"); }
                        KeyButton { x: 76px; y: 264px; value: "6"; pressed => AppState.wifi-key-pressed("6"); }
                        KeyButton { x: 144px; y: 264px; value: "7"; pressed => AppState.wifi-key-pressed("7"); }
                        KeyButton { x: 212px; y: 264px; value: "8"; pressed => AppState.wifi-key-pressed("8"); }
                        KeyButton { x: 280px; y: 264px; value: "9"; pressed => AppState.wifi-key-pressed("9"); }

                        KeyButton { x: 8px; y: 308px; value: "0"; pressed => AppState.wifi-key-pressed("0"); }
                        KeyButton { x: 76px; y: 308px; value: "SHIFT"; pressed => AppState.wifi-key-pressed("SHIFT"); }
                        KeyButton { x: 144px; y: 308px; value: "SYM"; pressed => AppState.wifi-key-pressed("SYM"); }
                        KeyButton { x: 212px; y: 308px; value: "SPACE"; pressed => AppState.wifi-key-pressed("SPACE"); }
                        KeyButton { x: 280px; y: 308px; value: "BACK"; pressed => AppState.wifi-key-pressed("BACK"); }
                    }
                }

                NavButton {
                    x: 60px;
                    y: 270px;
                    button-width: 108px;
                    label: "返回扫描";
                    activated => {
                        root.menu-view = 6;
                    }
                }
                NavButton {
                    x: 188px;
                    y: 270px;
                    button-width: 108px;
                    label: "连接 WiFi";
                    activated => {
                        AppState.wifi-password-submit();
                    }
                }
            }
}
